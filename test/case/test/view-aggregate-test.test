-- 测试视图上的聚合函数
-- 1. 测试简单列的聚合
create table t_simple(id int, age int, name char(15));
insert into t_simple values(1, 10, 'Alice');
insert into t_simple values(2, 20, 'Bob');
insert into t_simple values(3, 30, 'Charlie');
create view v_simple as select id, age from t_simple;
select count(*) from v_simple;
select count(id) from v_simple;
select sum(age) from v_simple;
select avg(age) from v_simple;
select max(age) from v_simple;
select min(age) from v_simple;

-- 2. 测试计算列（加法）的聚合
create table t_add(id int, age int);
insert into t_add values(1, 10);
insert into t_add values(2, 20);
insert into t_add values(3, 30);
create view v_add as select id, age, id+age as total from t_add;
select count(*) from v_add;
select sum(total) from v_add;
select avg(total) from v_add;
select max(total) from v_add;
select min(total) from v_add;

-- 3. 测试计算列（乘法）的聚合
create table t_mul(id int, value int);
insert into t_mul values(1, 100);
insert into t_mul values(2, 200);
insert into t_mul values(3, 300);
create view v_mul as select id, value*2 as double_value from t_mul;
select count(*) from v_mul;
select sum(double_value) from v_mul;
select avg(double_value) from v_mul;
select max(double_value) from v_mul;
select min(double_value) from v_mul;

-- 4. 测试计算列（减法）的聚合
create table t_sub(id int, score int);
insert into t_sub values(1, 100);
insert into t_sub values(2, 85);
insert into t_sub values(3, 90);
create view v_sub as select id, 100-score as penalty from t_sub;
select count(*) from v_sub;
select sum(penalty) from v_sub;

-- 5. 测试计算列（除法）的聚合
create table t_div(id int, total int);
insert into t_div values(1, 100);
insert into t_div values(2, 200);
create view v_div as select id, total/2 as half from t_div;
select sum(half) from v_div;

-- 6. 测试混合计算列
create table t_mixed(a int, b int, c int);
insert into t_mixed values(1, 2, 3);
insert into t_mixed values(4, 5, 6);
create view v_mixed as select a, b, c, a+b*c as complex from t_mixed;
select sum(complex) from v_mixed;

-- 清理
drop table t_simple;
drop table t_add;
drop table t_mul;
drop table t_sub;
drop table t_div;
drop table t_mixed;
