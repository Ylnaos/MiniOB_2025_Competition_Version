-- 简单的create view测试用例
-- 测试表名: t987
-- 测试场景: 包含计算列的视图

-- 创建测试表
CREATE TABLE t987(id INT, age INT);
SUCCESS

-- 插入测试数据
INSERT INTO t987 VALUES (1, 10);
SUCCESS
INSERT INTO t987 VALUES (2, 20);
SUCCESS
INSERT INTO t987 VALUES (3, 30);
SUCCESS
INSERT INTO t987 VALUES (4, 40);
SUCCESS
INSERT INTO t987 VALUES (5, 50);
SUCCESS

-- 创建视图，包含计算列 id+age
CREATE VIEW view_t987_v1 AS SELECT id, age, id+age AS data FROM t987;
SUCCESS

-- 测试1: COUNT(*)
SELECT COUNT(*) FROM view_t987_v1;
COUNT(*)
5

-- 测试2: COUNT(id)
SELECT COUNT(id) FROM view_t987_v1;
COUNT(ID)
5

-- 测试3: SUM(age)
SELECT SUM(age) FROM view_t987_v1;
SUM(AGE)
150

-- 测试4: SUM(data) - 计算列的聚合
SELECT SUM(data) FROM view_t987_v1;
SUM(DATA)
165

-- 测试5: 查看所有数据
SELECT * FROM view_t987_v1;
ID | AGE | DATA
1 | 10 | 11
2 | 20 | 22
3 | 30 | 33
4 | 40 | 44
5 | 50 | 55

-- 测试6: 带WHERE条件的查询
SELECT * FROM view_t987_v1 WHERE age > 25;
ID | AGE | DATA
3 | 30 | 33
4 | 40 | 44
5 | 50 | 55

-- 清理
DROP VIEW view_t987_v1;
SUCCESS
DROP TABLE t987;
SUCCESS
